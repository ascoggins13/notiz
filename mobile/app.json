{
  "expo": {
    "name": "Notiz",
    "slug": "notiz",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Notiz uses your location to show nearby places where you can check in and connect with people you notice."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.scogginstechnologies.notiz",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.scogginstechnologies.notiz"
    },
    "extra": {
      "eas": {
        "projectId": "d896626d-083d-4bac-ad6a-de0b32292586"
      }
    },
    "owner": "ascogginstech"
  }
}
